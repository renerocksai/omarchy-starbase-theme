# Starbase: btop as a launch-control telemetry board.
# Steel boxes, Mars-orange titles, and graphs that heat up from
# methalox blue through steel to exhaust orange.

theme[main_bg]="#0a0b0d"
theme[main_fg]="#d4d7db"
theme[title]="#f8661c"
theme[hi_fg]="#ffb347"
theme[selected_bg]="#2a2e33"
theme[selected_fg]="#ffb347"
theme[inactive_fg]="#5a6068"
theme[graph_text]="#9ea4ab"
theme[meter_bg]="#1d2024"
theme[proc_misc]="#9ea4ab"

theme[cpu_box]="#3a3f46"
theme[mem_box]="#3a3f46"
theme[net_box]="#3a3f46"
theme[proc_box]="#3a3f46"
theme[div_line]="#2a2e33"

# Temperature: nominal steel, warming amber, abort red
theme[temp_start]="#9ea4ab"
theme[temp_mid]="#f5a524"
theme[temp_end]="#e5484d"

# CPU: ignition sequence, methalox blue to full thrust orange
theme[cpu_start]="#7ea3d0"
theme[cpu_mid]="#d4d7db"
theme[cpu_end]="#f8661c"

theme[free_start]="#3a3f46"
theme[free_mid]="#7ea3d0"
theme[free_end]="#a6d7e1"

theme[cached_start]="#5a6068"
theme[cached_mid]="#86b9c4"
theme[cached_end]="#a6d7e1"

theme[available_start]="#5a6068"
theme[available_mid]="#9ea4ab"
theme[available_end]="#d4d7db"

theme[used_start]="#ffb347"
theme[used_mid]="#f8661c"
theme[used_end]="#e5484d"

# Downlink cool, uplink hot
theme[download_start]="#3d5571"
theme[download_mid]="#7ea3d0"
theme[download_end]="#a6d7e1"

theme[upload_start]="#8a4520"
theme[upload_mid]="#f8661c"
theme[upload_end]="#ffb347"

theme[process_start]="#9ea4ab"
theme[process_mid]="#f5a524"
theme[process_end]="#f8661c"

theme[gradient_color_0]="#0a0b0d"
theme[gradient_color_1]="#15171a"
theme[gradient_color_2]="#2a2e33"
theme[gradient_color_3]="#5a6068"
theme[gradient_color_4]="#9ea4ab"
theme[gradient_color_5]="#d4d7db"
theme[gradient_color_6]="#ffb347"
theme[gradient_color_7]="#f8661c"
